Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.5
      Cell Size: 1
      Class: rviz_default_plugins/Grid
      Color: 160; 160; 164
      Enabled: true
      Name: Map Grid
      Plane: XY
      Reference Frame: map
    - Class: rviz_default_plugins/Map
      Enabled: true
      Name: Saved Map
      Topic:
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        Value: /map
    - Class: rviz_default_plugins/LaserScan
      Enabled: true
      Name: Raw Scan Including Test Objects
      Size (Pixels): 3
      Style: Points
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /scan
    - Class: rviz_default_plugins/RobotModel
      Enabled: true
      Name: Robot
      Robot Description: robot_description
    - Class: rviz_default_plugins/TF
      Enabled: true
      Frame Timeout: 15
      Frames:
        All Enabled: true
      Marker Scale: 0.5
      Name: TF Tree
      Show Arrows: true
      Show Axes: true
      Show Names: true
      Update Interval: 0
    - Class: rviz_default_plugins/Axes
      Enabled: true
      Length: 0.8
      Name: Odom Frame In Map
      Radius: 0.04
      Reference Frame: odom
    - Class: rviz_default_plugins/Odometry
      Angle Tolerance: 0.001
      Enabled: true
      Keep: 200
      Name: Filtered Odom Transformed Into Map
      Position Tolerance: 0.001
      Shape:
        Alpha: 0.8
        Axes Length: 0.25
        Axes Radius: 0.015
        Color: 25; 255; 80
        Head Length: 0.07
        Head Radius: 0.04
        Shaft Length: 0.23
        Shaft Radius: 0.02
        Value: Arrow
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /odometry/filtered
    - Class: rviz_default_plugins/PoseWithCovariance
      Enabled: true
      Name: AMCL Pose
      Topic:
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        Value: /amcl_pose
    - Class: nav2_rviz_plugins/ParticleCloud
      Enabled: true
      Name: AMCL Particle Cloud
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /particle_cloud
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/SetInitialPose
      Covariance x: 0.25
      Covariance y: 0.25
      Covariance yaw: 0.06853891909122467
      Topic:
        Value: /initialpose
  Value: true
