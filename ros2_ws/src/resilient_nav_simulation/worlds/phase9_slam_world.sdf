<?xml version="1.0"?>
<sdf version="1.10">
  <world name="resilient_lab">
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <physics name="default_physics" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="ground_link">
        <pose>0 0 -0.05 0 0 0</pose>
        <collision name="ground_collision">
          <geometry><box><size>14 14 0.1</size></box></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="ground_visual">
          <geometry><box><size>14 14 0.1</size></box></geometry>
          <material><ambient>0.30 0.30 0.30 1</ambient><diffuse>0.42 0.42 0.42 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- A 12 m room keeps every route wall inside the 12 m LiDAR range. -->
    <model name="wall_north"><static>true</static><pose>0 5.75 0.5 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>12 0.25 1</size></box></geometry></collision><visual name="visual"><geometry><box><size>12 0.25 1</size></box></geometry></visual></link></model>
    <model name="wall_south"><static>true</static><pose>0 -5.75 0.5 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>12 0.25 1</size></box></geometry></collision><visual name="visual"><geometry><box><size>12 0.25 1</size></box></geometry></visual></link></model>
    <model name="wall_west"><static>true</static><pose>-5.75 0 0.5 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>0.25 12 1</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.25 12 1</size></box></geometry></visual></link></model>
    <model name="wall_east"><static>true</static><pose>5.75 0 0.5 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>0.25 12 1</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.25 12 1</size></box></geometry></visual></link></model>

    <!-- Asymmetric L and T structures provide distinct corners for scan matching. -->
    <model name="l_horizontal"><static>true</static><pose>-0.9 3.15 0.55 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>2.5 0.25 1.1</size></box></geometry></collision><visual name="visual"><geometry><box><size>2.5 0.25 1.1</size></box></geometry></visual></link></model>
    <model name="l_vertical"><static>true</static><pose>0.225 2.15 0.55 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>0.25 2.25 1.1</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.25 2.25 1.1</size></box></geometry></visual></link></model>
    <model name="t_horizontal"><static>true</static><pose>3.45 2.45 0.5 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>2.1 0.25 1</size></box></geometry></collision><visual name="visual"><geometry><box><size>2.1 0.25 1</size></box></geometry></visual></link></model>
    <model name="t_vertical"><static>true</static><pose>3.45 1.55 0.5 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>0.25 2.0 1</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.25 2.0 1</size></box></geometry></visual></link></model>

    <!-- Non-route-side obstacles make occlusion and free-space evidence asymmetric. -->
    <model name="central_rectangular_obstacle"><static>true</static><pose>2.25 -1.35 0.45 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>1.4 0.9 0.9</size></box></geometry></collision><visual name="visual"><geometry><box><size>1.4 0.9 0.9</size></box></geometry></visual></link></model>
    <model name="northwest_occluder"><static>true</static><pose>-3.1 2.9 0.65 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>0.8 1.6 1.3</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.8 1.6 1.3</size></box></geometry></visual></link></model>
    <model name="east_cylinder"><static>true</static><pose>4.25 -1.3 0.45 0 0 0</pose><link name="link"><collision name="collision"><geometry><cylinder><radius>0.45</radius><length>0.9</length></cylinder></geometry></collision><visual name="visual"><geometry><cylinder><radius>0.45</radius><length>0.9</length></cylinder></geometry></visual></link></model>
    <model name="small_asymmetric_block"><static>true</static><pose>-1.4 -1.25 0.35 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>0.8 0.5 0.7</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.8 0.5 0.7</size></box></geometry></visual></link></model>
  </world>
</sdf>
