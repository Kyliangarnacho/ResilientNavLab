<?xml version="1.0"?>
<robot name="resilient_nav_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:arg name="gazebo_model_name" default="resilient_nav_robot"/>

  <xacro:property name="base_length" value="0.50"/>
  <xacro:property name="base_width" value="0.35"/>
  <xacro:property name="base_height" value="0.15"/>
  <xacro:property name="base_mass" value="5.0"/>
  <xacro:property name="base_z" value="0.15"/>
  <xacro:property name="base_com_x" value="-0.05"/>
  <xacro:property name="base_com_z" value="-0.04"/>

  <xacro:property name="wheel_radius" value="0.10"/>
  <xacro:property name="wheel_width" value="0.04"/>
  <xacro:property name="wheel_mass" value="0.50"/>
  <xacro:property name="wheel_x" value="0.10"/>
  <xacro:property name="wheel_y" value="${base_width / 2.0 + wheel_width / 2.0}"/>
  <xacro:property name="wheel_separation" value="${2.0 * wheel_y}"/>
  <xacro:property name="wheel_z" value="${wheel_radius - base_z}"/>
  <!-- Modest physical slip avoids an unrealistically ideal wheel odometry. -->
  <xacro:property name="wheel_slip_compliance_lateral" value="0.004"/>
  <xacro:property name="wheel_slip_compliance_longitudinal" value="0.002"/>
  <xacro:property name="wheel_normal_force" value="25.0"/>

  <xacro:property name="caster_radius" value="0.05"/>
  <xacro:property name="caster_mass" value="0.20"/>
  <xacro:property name="caster_x" value="-0.20"/>
  <xacro:property name="caster_z" value="${caster_radius - base_z}"/>

  <xacro:property name="body_friction" value="0.5"/>
  <xacro:property name="wheel_friction" value="1.0"/>
  <xacro:property name="caster_friction" value="0.05"/>

  <!-- Stage 4 mounting transforms. All values are relative to the named parent link. -->
  <xacro:property name="imu_xyz" value="${base_com_x} 0 0.08"/>
  <xacro:property name="imu_rpy" value="0 0 0"/>
  <xacro:property name="lidar_xyz" value="0 0 0.20"/>
  <xacro:property name="lidar_rpy" value="0 0 0"/>
  <xacro:property name="imu_update_rate" value="100"/>
  <xacro:property name="imu_angular_velocity_noise_stddev" value="0.0002"/>
  <xacro:property name="imu_linear_acceleration_noise_stddev" value="0.01"/>
  <xacro:property name="lidar_update_rate" value="15"/>
  <!-- Repeated /scan evidence identifies the inclusive -135 degree source
       beam as anomalous.  Exclude only that source ray while preserving the
       verified angular increment of every retained beam. -->
  <xacro:property name="lidar_horizontal_samples" value="639"/>
  <xacro:property name="lidar_min_angle" value="${-3.0 * pi / 4.0 + pi / 426.0}"/>
  <xacro:property name="lidar_max_angle" value="${3.0 * pi / 4.0}"/>
  <xacro:property name="lidar_min_range" value="0.08"/>
  <xacro:property name="lidar_max_range" value="12.0"/>
  <xacro:property name="lidar_range_noise_stddev" value="0.005"/>
  <xacro:property name="camera_mount_xyz" value="0.18 0 0.11"/>
  <xacro:property name="camera_mount_rpy" value="0 0 0"/>
  <xacro:property name="camera_xyz" value="0.07 0 0.04"/>
  <xacro:property name="camera_rpy" value="0 0 0"/>
  <xacro:property name="camera_optical_xyz" value="0 0 0"/>
  <xacro:property
    name="camera_optical_rpy"
    value="${-pi / 2.0} 0 ${-pi / 2.0}"/>
  <xacro:property name="camera_update_rate" value="30"/>
  <xacro:property name="camera_horizontal_fov" value="1.047"/>
  <xacro:property name="camera_image_width" value="640"/>
  <xacro:property name="camera_image_height" value="480"/>
  <xacro:property name="camera_clip_near" value="0.1"/>
  <xacro:property name="camera_clip_far" value="10.0"/>
  <xacro:property
    name="arm_mount_xyz"
    value="-0.10 0 ${base_height / 2.0}"/>
  <xacro:property name="arm_mount_rpy" value="0 0 0"/>

  <material name="body_blue">
    <color rgba="0.15 0.35 0.80 1.0"/>
  </material>

  <material name="wheel_dark">
    <color rgba="0.08 0.08 0.08 1.0"/>
  </material>

  <material name="caster_gray">
    <color rgba="0.45 0.45 0.45 1.0"/>
  </material>

  <material name="sensor_orange">
    <color rgba="1.0 0.45 0.05 1.0"/>
  </material>

  <material name="sensor_green">
    <color rgba="0.10 0.70 0.25 1.0"/>
  </material>

  <material name="sensor_gray">
    <color rgba="0.25 0.25 0.30 1.0"/>
  </material>

  <xacro:macro name="drive_wheel" params="side y_position">
    <link name="${side}_wheel_link">
      <visual>
        <origin xyz="0 0 0" rpy="${pi / 2.0} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <material name="wheel_dark"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${pi / 2.0} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="${wheel_mass}"/>
        <inertia
          ixx="${wheel_mass * (3.0 * wheel_radius * wheel_radius + wheel_width * wheel_width) / 12.0}"
          ixy="0"
          ixz="0"
          iyy="${wheel_mass * wheel_radius * wheel_radius / 2.0}"
          iyz="0"
          izz="${wheel_mass * (3.0 * wheel_radius * wheel_radius + wheel_width * wheel_width) / 12.0}"/>
      </inertial>
    </link>

    <joint name="${side}_wheel_joint" type="continuous">
      <origin xyz="${wheel_x} ${y_position} ${wheel_z}" rpy="0 0 0"/>
      <parent link="base_link"/>
      <child link="${side}_wheel_link"/>
      <axis xyz="0 1 0"/>
      <dynamics damping="0.05" friction="0.0"/>
    </joint>
  </xacro:macro>

  <link name="base_footprint"/>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
      <material name="body_blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="${base_com_x} 0 ${base_com_z}" rpy="0 0 0"/>
      <mass value="${base_mass}"/>
      <inertia
        ixx="${base_mass * (base_width * base_width + base_height * base_height) / 12.0}"
        ixy="0"
        ixz="0"
        iyy="${base_mass * (base_length * base_length + base_height * base_height) / 12.0}"
        iyz="0"
        izz="${base_mass * (base_length * base_length + base_width * base_width) / 12.0}"/>
    </inertial>
  </link>

  <joint name="base_footprint_joint" type="fixed">
    <origin xyz="${-wheel_x} 0 ${base_z}" rpy="0 0 0"/>
    <parent link="base_footprint"/>
    <child link="base_link"/>
  </joint>

  <link name="imu_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.04 0.03 0.015"/>
      </geometry>
      <material name="sensor_orange"/>
    </visual>
  </link>

  <joint name="imu_joint" type="fixed">
    <origin xyz="${imu_xyz}" rpy="${imu_rpy}"/>
    <parent link="base_link"/>
    <child link="imu_link"/>
  </joint>

  <link name="lidar_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.04" length="0.04"/>
      </geometry>
      <material name="sensor_green"/>
    </visual>
  </link>

  <joint name="lidar_joint" type="fixed">
    <origin xyz="${lidar_xyz}" rpy="${lidar_rpy}"/>
    <parent link="base_link"/>
    <child link="lidar_link"/>
  </joint>

  <link name="camera_mount_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.03 0.04 0.06"/>
      </geometry>
      <material name="sensor_gray"/>
    </visual>
  </link>

  <joint name="camera_mount_joint" type="fixed">
    <origin xyz="${camera_mount_xyz}" rpy="${camera_mount_rpy}"/>
    <parent link="base_link"/>
    <child link="camera_mount_link"/>
  </joint>

  <link name="camera_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.06 0.08 0.04"/>
      </geometry>
      <material name="sensor_gray"/>
    </visual>
  </link>

  <joint name="camera_joint" type="fixed">
    <origin xyz="${camera_xyz}" rpy="${camera_rpy}"/>
    <parent link="camera_mount_link"/>
    <child link="camera_link"/>
  </joint>

  <link name="camera_optical_frame"/>

  <joint name="camera_optical_joint" type="fixed">
    <origin xyz="${camera_optical_xyz}" rpy="${camera_optical_rpy}"/>
    <parent link="camera_link"/>
    <child link="camera_optical_frame"/>
  </joint>

  <link name="arm_mount_link"/>

  <joint name="arm_mount_joint" type="fixed">
    <origin xyz="${arm_mount_xyz}" rpy="${arm_mount_rpy}"/>
    <parent link="base_link"/>
    <child link="arm_mount_link"/>
  </joint>

  <xacro:drive_wheel side="left" y_position="${wheel_y}"/>
  <xacro:drive_wheel side="right" y_position="${-wheel_y}"/>

  <link name="caster_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="${caster_radius}"/>
      </geometry>
      <material name="caster_gray"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="${caster_radius}"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="${caster_mass}"/>
      <inertia
        ixx="${2.0 * caster_mass * caster_radius * caster_radius / 5.0}"
        ixy="0"
        ixz="0"
        iyy="${2.0 * caster_mass * caster_radius * caster_radius / 5.0}"
        iyz="0"
        izz="${2.0 * caster_mass * caster_radius * caster_radius / 5.0}"/>
    </inertial>
  </link>

  <joint name="caster_joint" type="fixed">
    <origin xyz="${caster_x} 0 ${caster_z}" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="caster_link"/>
  </joint>

  <gazebo reference="base_link">
    <mu1>${body_friction}</mu1>
    <mu2>${body_friction}</mu2>
    <material>Gazebo/Blue</material>
  </gazebo>

  <gazebo reference="left_wheel_link">
    <mu1>${wheel_friction}</mu1>
    <mu2>${wheel_friction}</mu2>
    <fdir1>0 1 0</fdir1>
    <material>Gazebo/Black</material>
  </gazebo>

  <gazebo reference="right_wheel_link">
    <mu1>${wheel_friction}</mu1>
    <mu2>${wheel_friction}</mu2>
    <fdir1>0 1 0</fdir1>
    <material>Gazebo/Black</material>
  </gazebo>

  <gazebo reference="caster_link">
    <mu1>${caster_friction}</mu1>
    <mu2>${caster_friction}</mu2>
    <material>Gazebo/Grey</material>
  </gazebo>

  <gazebo reference="imu_link">
    <sensor name="imu_sensor" type="imu">
      <always_on>true</always_on>
      <update_rate>${imu_update_rate}</update_rate>
      <topic>/imu/data</topic>
      <gz_frame_id>imu_link</gz_frame_id>
      <imu>
        <angular_velocity>
          <x>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>${imu_angular_velocity_noise_stddev}</stddev>
            </noise>
          </x>
          <y>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>${imu_angular_velocity_noise_stddev}</stddev>
            </noise>
          </y>
          <z>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>${imu_angular_velocity_noise_stddev}</stddev>
            </noise>
          </z>
        </angular_velocity>
        <linear_acceleration>
          <x>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>${imu_linear_acceleration_noise_stddev}</stddev>
            </noise>
          </x>
          <y>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>${imu_linear_acceleration_noise_stddev}</stddev>
            </noise>
          </y>
          <z>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>${imu_linear_acceleration_noise_stddev}</stddev>
            </noise>
          </z>
        </linear_acceleration>
        <enable_orientation>true</enable_orientation>
      </imu>
    </sensor>
  </gazebo>

  <gazebo reference="lidar_link">
    <sensor name="lidar_sensor" type="gpu_lidar">
      <always_on>true</always_on>
      <update_rate>${lidar_update_rate}</update_rate>
      <topic>/scan</topic>
      <gz_frame_id>lidar_link</gz_frame_id>
      <lidar>
        <scan>
          <horizontal>
            <samples>${lidar_horizontal_samples}</samples>
            <resolution>1</resolution>
            <min_angle>${lidar_min_angle}</min_angle>
            <max_angle>${lidar_max_angle}</max_angle>
          </horizontal>
          <vertical>
            <samples>1</samples>
            <resolution>1</resolution>
            <min_angle>0</min_angle>
            <max_angle>0</max_angle>
          </vertical>
        </scan>
        <range>
          <min>${lidar_min_range}</min>
          <max>${lidar_max_range}</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>${lidar_range_noise_stddev}</stddev>
        </noise>
      </lidar>
      <visualize>false</visualize>
    </sensor>
  </gazebo>

  <gazebo reference="camera_link">
    <sensor name="rgbd_camera_sensor" type="rgbd_camera">
      <always_on>true</always_on>
      <update_rate>${camera_update_rate}</update_rate>
      <topic>/camera</topic>
      <gz_frame_id>camera_optical_frame</gz_frame_id>
      <camera>
        <horizontal_fov>${camera_horizontal_fov}</horizontal_fov>
        <image>
          <width>${camera_image_width}</width>
          <height>${camera_image_height}</height>
        </image>
        <clip>
          <near>${camera_clip_near}</near>
          <far>${camera_clip_far}</far>
        </clip>
      </camera>
      <visualize>false</visualize>
    </sensor>
  </gazebo>

  <gazebo>
    <!-- Evaluation-only world-pose source.  This is deliberately separate
         from DiffDrive's odom/tf output so physical slip remains observable. -->
    <plugin
      filename="gz-sim-pose-publisher-system"
      name="gz::sim::systems::PosePublisher">
      <publish_link_pose>false</publish_link_pose>
      <publish_model_pose>true</publish_model_pose>
      <!-- Harmonic releases before the publish_model_pose fix require this
           compatibility flag for the top-level model pose. -->
      <publish_nested_model_pose>true</publish_nested_model_pose>
      <publish_visual_pose>false</publish_visual_pose>
      <publish_collision_pose>false</publish_collision_pose>
      <publish_sensor_pose>false</publish_sensor_pose>
      <use_pose_vector_msg>true</use_pose_vector_msg>
      <update_frequency>50</update_frequency>
    </plugin>

    <plugin
      filename="gz-sim-diff-drive-system"
      name="gz::sim::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>${wheel_separation}</wheel_separation>
      <wheel_radius>${wheel_radius}</wheel_radius>
      <topic>/model/$(arg gazebo_model_name)/cmd_vel</topic>
      <odom_topic>/model/$(arg gazebo_model_name)/odometry</odom_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
    </plugin>

    <plugin
      filename="gz-sim-wheel-slip-system"
      name="gz::sim::systems::WheelSlip">
      <wheel link_name="left_wheel_link">
        <wheel_radius>${wheel_radius}</wheel_radius>
        <wheel_normal_force>${wheel_normal_force}</wheel_normal_force>
        <slip_compliance_lateral>${wheel_slip_compliance_lateral}</slip_compliance_lateral>
        <slip_compliance_longitudinal>${wheel_slip_compliance_longitudinal}</slip_compliance_longitudinal>
      </wheel>
      <wheel link_name="right_wheel_link">
        <wheel_radius>${wheel_radius}</wheel_radius>
        <wheel_normal_force>${wheel_normal_force}</wheel_normal_force>
        <slip_compliance_lateral>${wheel_slip_compliance_lateral}</slip_compliance_lateral>
        <slip_compliance_longitudinal>${wheel_slip_compliance_longitudinal}</slip_compliance_longitudinal>
      </wheel>
    </plugin>

    <plugin
      filename="gz-sim-joint-state-publisher-system"
      name="gz::sim::systems::JointStatePublisher">
      <topic>/world/resilient_lab/model/$(arg gazebo_model_name)/joint_state</topic>
      <joint_name>left_wheel_joint</joint_name>
      <joint_name>right_wheel_joint</joint_name>
    </plugin>
  </gazebo>
</robot>
