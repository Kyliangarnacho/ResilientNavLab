<?xml version="1.0"?>
<robot name="resilient_nav_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:arg name="gazebo_model_name" default="resilient_nav_robot"/>

  <xacro:property name="base_length" value="0.50"/>
  <xacro:property name="base_width" value="0.35"/>
  <xacro:property name="base_height" value="0.15"/>
  <xacro:property name="base_mass" value="5.0"/>
  <xacro:property name="base_z" value="0.15"/>
  <xacro:property name="base_com_x" value="-0.05"/>
  <xacro:property name="base_com_z" value="-0.04"/>

  <xacro:property name="wheel_radius" value="0.10"/>
  <xacro:property name="wheel_width" value="0.04"/>
  <xacro:property name="wheel_mass" value="0.50"/>
  <xacro:property name="wheel_x" value="0.10"/>
  <xacro:property name="wheel_y" value="${base_width / 2.0 + wheel_width / 2.0}"/>
  <xacro:property name="wheel_separation" value="${2.0 * wheel_y}"/>
  <xacro:property name="wheel_z" value="${wheel_radius - base_z}"/>

  <xacro:property name="caster_radius" value="0.05"/>
  <xacro:property name="caster_mass" value="0.20"/>
  <xacro:property name="caster_x" value="-0.20"/>
  <xacro:property name="caster_z" value="${caster_radius - base_z}"/>

  <xacro:property name="body_friction" value="0.5"/>
  <xacro:property name="wheel_friction" value="1.0"/>
  <xacro:property name="caster_friction" value="0.05"/>

  <material name="body_blue">
    <color rgba="0.15 0.35 0.80 1.0"/>
  </material>

  <material name="wheel_dark">
    <color rgba="0.08 0.08 0.08 1.0"/>
  </material>

  <material name="caster_gray">
    <color rgba="0.45 0.45 0.45 1.0"/>
  </material>

  <xacro:macro name="drive_wheel" params="side y_position">
    <link name="${side}_wheel_link">
      <visual>
        <origin xyz="0 0 0" rpy="${pi / 2.0} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <material name="wheel_dark"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${pi / 2.0} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="${wheel_mass}"/>
        <inertia
          ixx="${wheel_mass * (3.0 * wheel_radius * wheel_radius + wheel_width * wheel_width) / 12.0}"
          ixy="0"
          ixz="0"
          iyy="${wheel_mass * wheel_radius * wheel_radius / 2.0}"
          iyz="0"
          izz="${wheel_mass * (3.0 * wheel_radius * wheel_radius + wheel_width * wheel_width) / 12.0}"/>
      </inertial>
    </link>

    <joint name="${side}_wheel_joint" type="continuous">
      <origin xyz="${wheel_x} ${y_position} ${wheel_z}" rpy="0 0 0"/>
      <parent link="base_link"/>
      <child link="${side}_wheel_link"/>
      <axis xyz="0 1 0"/>
      <dynamics damping="0.05" friction="0.0"/>
    </joint>
  </xacro:macro>

  <link name="base_footprint"/>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
      <material name="body_blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="${base_com_x} 0 ${base_com_z}" rpy="0 0 0"/>
      <mass value="${base_mass}"/>
      <inertia
        ixx="${base_mass * (base_width * base_width + base_height * base_height) / 12.0}"
        ixy="0"
        ixz="0"
        iyy="${base_mass * (base_length * base_length + base_height * base_height) / 12.0}"
        iyz="0"
        izz="${base_mass * (base_length * base_length + base_width * base_width) / 12.0}"/>
    </inertial>
  </link>

  <joint name="base_footprint_joint" type="fixed">
    <origin xyz="${-wheel_x} 0 ${base_z}" rpy="0 0 0"/>
    <parent link="base_footprint"/>
    <child link="base_link"/>
  </joint>

  <xacro:drive_wheel side="left" y_position="${wheel_y}"/>
  <xacro:drive_wheel side="right" y_position="${-wheel_y}"/>

  <link name="caster_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="${caster_radius}"/>
      </geometry>
      <material name="caster_gray"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="${caster_radius}"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="${caster_mass}"/>
      <inertia
        ixx="${2.0 * caster_mass * caster_radius * caster_radius / 5.0}"
        ixy="0"
        ixz="0"
        iyy="${2.0 * caster_mass * caster_radius * caster_radius / 5.0}"
        iyz="0"
        izz="${2.0 * caster_mass * caster_radius * caster_radius / 5.0}"/>
    </inertial>
  </link>

  <joint name="caster_joint" type="fixed">
    <origin xyz="${caster_x} 0 ${caster_z}" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="caster_link"/>
  </joint>

  <gazebo reference="base_link">
    <mu1>${body_friction}</mu1>
    <mu2>${body_friction}</mu2>
    <material>Gazebo/Blue</material>
  </gazebo>

  <gazebo reference="left_wheel_link">
    <mu1>${wheel_friction}</mu1>
    <mu2>${wheel_friction}</mu2>
    <material>Gazebo/Black</material>
  </gazebo>

  <gazebo reference="right_wheel_link">
    <mu1>${wheel_friction}</mu1>
    <mu2>${wheel_friction}</mu2>
    <material>Gazebo/Black</material>
  </gazebo>

  <gazebo reference="caster_link">
    <mu1>${caster_friction}</mu1>
    <mu2>${caster_friction}</mu2>
    <material>Gazebo/Grey</material>
  </gazebo>

  <gazebo>
    <plugin
      filename="gz-sim-diff-drive-system"
      name="gz::sim::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>${wheel_separation}</wheel_separation>
      <wheel_radius>${wheel_radius}</wheel_radius>
      <topic>/model/$(arg gazebo_model_name)/cmd_vel</topic>
      <odom_topic>/model/$(arg gazebo_model_name)/odometry</odom_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
    </plugin>

    <plugin
      filename="gz-sim-joint-state-publisher-system"
      name="gz::sim::systems::JointStatePublisher">
      <topic>/world/resilient_lab/model/$(arg gazebo_model_name)/joint_state</topic>
      <joint_name>left_wheel_joint</joint_name>
      <joint_name>right_wheel_joint</joint_name>
    </plugin>
  </gazebo>
</robot>
