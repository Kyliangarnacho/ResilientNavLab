<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>resilient_nav_fusion</name>
  <version>0.0.0</version>
  <description>Pure-Python health-aware fusion policy contracts for ResilientNavLab.</description>
  <maintainer email="kylian@example.com">Kylian</maintainer>
  <license>Apache-2.0</license>

  <depend>geometry_msgs</depend>
  <depend>launch</depend>
  <depend>launch_ros</depend>
  <depend>nav_msgs</depend>
  <depend>rclpy</depend>
  <exec_depend>resilient_nav_fault_injection</exec_depend>
  <exec_depend>resilient_nav_health_assessment</exec_depend>
  <depend>resilient_nav_interfaces</depend>
  <exec_depend>resilient_nav_simulation</exec_depend>
  <exec_depend>robot_localization</exec_depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>tf2_msgs</depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>rviz2</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
