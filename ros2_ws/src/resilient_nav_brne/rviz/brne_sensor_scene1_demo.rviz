Panels:
  - Class: rviz_common/Displays
    Help Height: 78
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.7
      Class: rviz_default_plugins/Map
      Color Scheme: map
      Enabled: true
      Name: Map
      Topic:
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        Value: /map
      Value: true
    - Alpha: 0.55
      Class: rviz_default_plugins/Map
      Color Scheme: costmap
      Enabled: true
      Name: Global Costmap
      Topic:
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        Value: /global_costmap/costmap
      Value: true
    - Class: rviz_default_plugins/RobotModel
      Description Source: Topic
      Enabled: true
      Name: Robot
      Robot Description: robot_description
      Value: true
    - Class: rviz_default_plugins/TF
      Enabled: true
      Frame Timeout: 15
      Marker Scale: 0.3
      Name: TF
      Show Arrows: true
      Show Axes: true
      Show Names: false
      Value: true
    - Alpha: 1
      Class: rviz_default_plugins/Polygon
      Color: 0; 255; 0
      Enabled: true
      Name: Robot Footprint
      Topic:
        Reliability Policy: Reliable
        Value: /global_costmap/published_footprint
      Value: true
    - Class: rviz_default_plugins/LaserScan
      Color: 255; 255; 255
      Decay Time: 0
      Enabled: true
      Name: Robot LiDAR
      Size (Pixels): 3
      Style: Points
      Topic:
        Reliability Policy: Best Effort
        Value: /scan
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Sensor Dynamic Agents
      Topic:
        Reliability Policy: Reliable
        Value: /brne/sensor_dynamic_agents
      Value: true
    - Class: rviz_default_plugins/Path
      Color: 0; 170; 255
      Enabled: true
      Head Diameter: 0.08
      Head Length: 0.06
      Line Style: Lines
      Line Width: 0.05
      Name: Nav2 Global Plan
      Pose Style: None
      Topic:
        Reliability Policy: Reliable
        Value: /plan
      Value: true
    - Class: rviz_default_plugins/Path
      Color: 255; 0; 0
      Enabled: true
      Head Diameter: 0.10
      Head Length: 0.08
      Line Style: Lines
      Line Width: 0.10
      Name: BRNE Selected Prediction
      Pose Style: None
      Topic:
        Reliability Policy: Reliable
        Value: /brne/optimal_path
      Value: true
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 5.0
      Focal Point:
        X: 1.0
        Y: 0
        Z: 0
      Pitch: 0.785
      Yaw: 0.785
Window Geometry:
  Height: 900
  Width: 1400
