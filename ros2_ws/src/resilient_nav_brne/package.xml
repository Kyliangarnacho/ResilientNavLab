<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>resilient_nav_brne</name>
  <version>0.0.0</version>
  <description>Pinned BRNE wrapper, LiDAR dynamic-agent input, and armed Gazebo demos.</description>
  <maintainer email="kylian@example.com">Kylian</maintainer>
  <license>GPL-3.0-only</license>

  <depend>action_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav2_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>resilient_nav_interfaces</depend>
  <depend>tf2_ros</depend>
  <depend>visualization_msgs</depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>resilient_nav_navigation</exec_depend>
  <exec_depend>resilient_nav_fusion</exec_depend>
  <exec_depend>resilient_nav_simulation</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
